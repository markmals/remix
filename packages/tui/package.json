{
  "name": "@remix-run/tui",
  "version": "0.0.0",
  "description": "Terminal rendering for Remix UI, powered by @bomb.sh/tty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remix-run/remix.git",
    "directory": "packages/tui"
  },
  "homepage": "https://github.com/remix-run/remix/tree/main/packages/tui#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@bomb.sh/tty": "0.9.0",
    "@remix-run/ui": "workspace:^"
  },
  "devDependencies": {
    "@remix-run/assert": "workspace:^",
    "@remix-run/test": "workspace:^",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "clean": "git clean -fdX",
    "prepublishOnly": "pnpm run build",
    "test": "remix test",
    "test:bun": "bun x --bun remix test",
    "typecheck": "tsgo --noEmit"
  },
  "keywords": [
    "remix",
    "ui",
    "tui",
    "terminal",
    "renderer"
  ]
}
