  "dependencies": {
    "@remix-run/assets": "markmals/remix#preview/ui-universal-renderer&path:packages/assets",
    "@remix-run/fetch-router": "markmals/remix#preview/ui-universal-renderer&path:packages/fetch-router",
    "@remix-run/response": "markmals/remix#preview/ui-universal-renderer&path:packages/response",
    "@remix-run/ui": "markmals/remix#preview/ui-universal-renderer&path:packages/ui"
  },
  "keywords": [
    "fetch",
